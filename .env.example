# Sensitive, deployment-specific and frontend-build configuration.
#
# Non-sensitive backend defaults live in config/system.toml. Environment values
# override that file, so this remains the place for secrets and exceptional
# per-deployment overrides. .env.<APP_ENV> is still supported.

# Selects an optional .env.<APP_ENV> overlay. The default baseline is dev.
APP_ENV=dev

# Database URL may contain credentials and therefore stays outside system.toml.
DATABASE_URL=sqlite:///data/database.db


# =============================================================================
# Production secrets (set in a secret manager or deployment environment)
# =============================================================================

# JWT_SECRET_KEY=
# TWO_FACTOR_ENCRYPTION_KEY=

# Initial administrator; replace all three before production initialization.
# INIT_ADMIN_NAME=
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_EMAIL=

# MAIL_SENDER_PASSWORD=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET=
# TURNSTILE_SECRET_KEY=

# Tencent Cloud SMS credentials. Registration and phone-password-reset use the
# template configured in config/system.toml; its parameters are code, expiry minutes.
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

# WeChat Pay API v3 secret. Public merchant settings and the private-key path
# live in config/system.toml; keep payment_mode=mock until the callback is live.
# WECHAT_PAY_APIV3_KEY=32-byte-api-v3-key

# S3 credentials. Storage policy and endpoint are in config/system.toml.
# FILE_S3_ACCESS_KEY_ID=
# FILE_S3_SECRET_ACCESS_KEY=


# =============================================================================
# Frontend build and container-infrastructure variables
# =============================================================================

# VITE_API_BASE_URL=/api
# VITE_TURNSTILE_SITE_KEY=

# Host port for the app service
# HOST_PORT=8000

# docker-compose.postgres.yml only
# POSTGRES_PASSWORD=replace-with-a-secure-password
# POSTGRES_DB=template
# POSTGRES_USER=template

# PostgreSQL backup credentials and infrastructure configuration
# PG_BACKUP_ENABLED=true
# PG_BACKUP_MODE=auto
# PG_BACKUP_STANZA=template
# PG_BACKUP_REPO_CIPHER_PASS=
# PG_BACKUP_AGE_RECIPIENT=age1...
# PG_BACKUP_S3_BUCKET=
# PG_BACKUP_S3_ENDPOINT=s3.example.com
# PG_BACKUP_S3_PORT=443
# PG_BACKUP_S3_REGION=us-east-1
# PG_BACKUP_S3_ACCESS_KEY_ID=
# PG_BACKUP_S3_SECRET_ACCESS_KEY=
# PG_BACKUP_S3_PREFIX=/production-template
# PG_BACKUP_S3_URI_STYLE=path
# PG_BACKUP_S3_VERIFY_TLS=y


# =============================================================================
# Optional compatibility overrides for config/system.toml
# =============================================================================

# These are intentionally commented. Existing names continue to work and win
# over TOML, which is useful for temporary deployment-specific overrides.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# ENABLED_FEATURES=["auth","admin","files","example"]
# OAUTH_LIST=["GITHUB","GOOGLE"]
# EXTERNAL_PROVIDER_MOCK_LIST=["github_oauth","mail"]
